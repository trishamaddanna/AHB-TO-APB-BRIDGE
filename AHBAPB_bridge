    .haddr1(haddr1), 
    .haddr2(haddr2), 
    .hwdata1(hwdata1), 
    .hwdata2(hwdata2), 
    .hwritereg(hwritereg), 
    .tempselx(tempselx) 
    ); 
    APB_controller apb( 
    .valid(valid), 
    .hwritereg(hwritereg), 
    .hclk(hclk), 
    .hresetn(hresetn), 
    .hwrite(hwrite), 
    .haddr1(haddr1), 
    .haddr2(haddr2), 
    .hwdata1(hwdata1), 
    .hwdata2(hwdata2), 
    .tempselx(tempselx), 
    .prdata(prdata), 
    .pwrite(pwrite), 
    .penable(penable), 
    .hreadyout(hreadyout), 
    .pselx(pselx),     
    .pwdata(pwdata), 
    .paddr(paddr) 
     ); 
       endmodule 
